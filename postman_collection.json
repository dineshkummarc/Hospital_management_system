{
	"info": {
		"_postman_id": "hms-api-collection-v1",
		"name": "Hospital Management System API",
		"description": "Postman API Collection for Hospital Management System RESTful Endpoints (Laravel Sanctum Auth)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "Content-Type", "value": "application/json", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@hospital.com\",\n  \"password\": \"Admin@1234\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/login",
							"host": ["{{base_url}}"],
							"path": ["api", "login"]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "logout"]
						}
					}
				}
			]
		},
		{
			"name": "Dashboard",
			"item": [
				{
					"name": "Get Dashboard Data",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/dashboard",
							"host": ["{{base_url}}"],
							"path": ["api", "dashboard"]
						}
					}
				}
			]
		},
		{
			"name": "Stored Procedures",
			"item": [
				{
					"name": "Get Patient Stats (SP)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/sp/patient/1/stats",
							"host": ["{{base_url}}"],
							"path": ["api", "sp", "patient", "1", "stats"]
						}
					}
				},
				{
					"name": "Get Department Staff (SP)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/sp/department/1/staff",
							"host": ["{{base_url}}"],
							"path": ["api", "sp", "department", "1", "staff"]
						}
					}
				},
				{
					"name": "Get Upcoming Appointments (SP)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "Authorization", "value": "Bearer {{auth_token}}", "type": "text" }
						],
						"url": {
							"raw": "{{base_url}}/api/sp/appointments/upcoming?limit=5",
							"host": ["{{base_url}}"],
							"path": ["api", "sp", "appointments", "upcoming"],
							"query": [{ "key": "limit", "value": "5" }]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000"
		},
		{
			"key": "auth_token",
			"value": ""
		}
	]
}
